{
    "version": "0.2.0.0",
    "manifest_version": 3,
    "name": "ZNN Syrius Extension",
    "description": "A non-custodial Zenon wallet for Chromium browsers and compatible Zenon bridge applications.",
    "minimum_chrome_version": "102",
    "background": {
      "service_worker": "background.bundle.js"
    },
    "content_scripts": [
      {
        "matches": [
          "https://nom-bridge.0x3639.com/*",
          "https://bridge.bagswap.com/*",
          "https://staging.bridge.bagswap.com/*",
          "https://bridge.0x3639.com/*",
          "https://staging.bridge.0x3639.com/*",
          "https://bridge.mainnet.zenon.community/*",
          "http://testnet.bridge.0x3639.com/*"
        ],
        "js": ["inpage.bundle.js"],
        "run_at": "document_start",
        "world": "MAIN"
      },
      {
        "matches": [
          "https://nom-bridge.0x3639.com/*",
          "https://bridge.bagswap.com/*",
          "https://staging.bridge.bagswap.com/*",
          "https://bridge.0x3639.com/*",
          "https://staging.bridge.0x3639.com/*",
          "https://bridge.mainnet.zenon.community/*",
          "http://testnet.bridge.0x3639.com/*"
        ],
        "js": ["contentScript.bundle.js"],
        "css": ["content.styles.css"],
        "run_at": "document_start"
      }
    ],
    "action": {
      "default_icon": "icon-34.png",
      "default_popup": "popup.html"
    },
    "permissions": ["storage", "alarms"],
    "icons": {
      "128": "icon-128.png"
    },
    "devtools_page": "devtools.html",
    "content_security_policy": {
      "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
    },
    "web_accessible_resources": [
      {
        "resources": ["content.styles.css", "icon-128.png", "icon-34.png"],
        "matches": [
          "https://nom-bridge.0x3639.com/*",
          "https://bridge.bagswap.com/*",
          "https://staging.bridge.bagswap.com/*",
          "https://bridge.0x3639.com/*",
          "https://staging.bridge.0x3639.com/*",
          "https://bridge.mainnet.zenon.community/*",
          "http://testnet.bridge.0x3639.com/*"
        ]
      }
    ]
  }

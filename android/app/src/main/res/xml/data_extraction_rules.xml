<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the phone: not to Google's cloud backup, not to a device
     transfer. The wallet's encrypted keystore is in the WebView's storage, and
     a copy of it is a copy someone can try passwords against. Restore is the
     recovery phrase. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
